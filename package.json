{
  "name": "react-use-translation",
  "version": "1.3.0",
  "description": "Hooks enabled internationalization for react",
  "author": "ms007",
  "license": "MIT",
  "repository": "ms007/react-use-translation",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react",
    "translations",
    "i18n",
    "hooks"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsdown",
    "start": "tsdown --watch",
    "prepublishOnly": "npm run build",
    "predeploy": "cd example && npm install && npm run build",
    "deploy": "gh-pages -d example/build"
  },
  "peerDependencies": {
    "react": ">=16.8.4",
    "react-dom": ">=16.8.4"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "gh-pages": "6.3.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "neostandard": "0.14.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.1",
    "vitest": "5.0.5"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
